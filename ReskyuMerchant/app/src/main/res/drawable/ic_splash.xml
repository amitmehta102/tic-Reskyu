<?xml version="1.0" encoding="utf-8"?>
<!--
    Reskyu Merchant splash icon.
    Displayed centred on the brand-green background.
    72 × 72 dp, so Android crops it to a 2/3 circle safely.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Leaf / sprout shape — filled accent green -->
    <path
        android:fillColor="#95D5B2"
        android:pathData="
        M54,20
        C54,20 30,34 30,54
        C30,67 40,76 54,76
        C68,76 78,67 78,54
        C78,34 54,20 54,20Z" />

    <!-- Inner highlight petal -->
    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.18"
        android:pathData="
        M54,26
        C54,26 36,38 36,54
        C36,64 44,72 54,72
        C54,72 40,62 40,52
        C40,40 54,26 54,26Z" />

    <!-- Stem -->
    <path
        android:fillColor="#95D5B2"
        android:strokeColor="#95D5B2"
        android:strokeWidth="3"
        android:pathData="M54,74 L54,88" />

    <!-- "R" letterform — white, centred -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="
        M42,44 L42,68
        M42,44 L56,44
        C60,44 63,47 63,51
        C63,55 60,58 56,58
        L42,58
        M56,58 L64,68" />

</vector>
