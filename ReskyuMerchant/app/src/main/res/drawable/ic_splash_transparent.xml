<!--
    Fully transparent splash icon used to suppress the Android 12+
    system splash screen's automatic launcher-icon fallback.
    Setting windowSplashScreenAnimatedIcon to this drawable means the
    system splash shows only the plain brand-dark background, which
    blends seamlessly into the Compose MerchantSplashScreen.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Intentionally empty — fully transparent -->
</vector>
